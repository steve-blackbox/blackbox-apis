# ⚠️ Modèle de configuration — copier en ".env" et compléter avec vos vraies valeurs.
# Ce fichier (.env.example) est sans secret et peut être commité sans risque.
# ".env" lui-même reste toujours exclu du dépôt (voir .gitignore).

# --- Tableau de bord de traction (admin-dashboard.html + /api/admin/stats) ---
# Clé secrète à fournir en en-tête "x-admin-key" pour consulter le dashboard.
ADMIN_DASHBOARD_KEY=

# Date de lancement figée (format YYYY-MM-DD) servant de J0 aux checkpoints J+30/60/90.
# Optionnelle — fixée automatiquement au premier démarrage du serveur si absente.
# LAUNCH_DATE=2026-01-01

# --- E-mail d'activation de licence (optionnel : sans elle, le serveur log une erreur
# claire au lieu de planter, voir server.js) ---
RESEND_API_KEY=

# --- Clé de test interne optionnelle (jamais de valeur fixe codée en dur dans le code :
# voir server.js / rebuildLicenseCaches). Laisser vide en production. ---
# INTERNAL_TEST_LICENSE_KEY=

# --- Paddle (processeur de paiement unique — merchant of record) ---
# PADDLE_ENV=sandbox tant que le compte live n'est pas prêt, puis "production".
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_PRICE_SOLO_MONTHLY=
PADDLE_PRICE_ALLACCESS_MONTHLY=
PADDLE_WEBHOOK_SECRET=

# --- Allowlist IP du webhook Paddle (défense en profondeur, voir server.js) ---
# Laisser absent/false pendant la phase de surveillance (log uniquement, ne bloque rien).
# Ne passer à "true" qu'après avoir confirmé dans les logs Render qu'un vrai webhook
# Paddle est bien reconnu (sinon risque de bloquer silencieusement tous les paiements).
# PADDLE_WEBHOOK_IP_ENFORCE=false
