{
  "info": {
    "name": "BlackBox Labs — 12 Developer APIs",
    "description": "12 focused, single-purpose developer APIs: privacy & PII protection, security & link integrity, and data & media utilities. Every endpoint requires a Bearer API key (get one at https://blackbox-apis.com/). All request/response fields below match the live production contract exactly — copy/paste ready.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b1a2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{api_key}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "https://blackbox-apis.com", "type": "string" },
    { "key": "api_key", "value": "YOUR_KEY", "type": "string" }
  ],
  "item": [
    {
      "name": "Privacy & PII Protection",
      "item": [
        {
          "name": "PII Masker",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/pii_masker", "host": ["{{base_url}}"], "path": ["v1", "pii_masker"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"raw_payload_text\": \"Contact John at john.doe@example.com or card 4111111111111111\"\n}"
            },
            "description": "Masks emails and Luhn-validated card numbers found anywhere in a free-text payload. Output format: cards -> XXXX-XXXX-XXXX-1234, emails -> j***@domain.com."
          }
        },
        {
          "name": "Phone Sanitizer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/phone_sanitizer", "host": ["{{base_url}}"], "path": ["v1", "phone_sanitizer"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"raw_phone_string\": \"+33 6 12 34 56 78\",\n  \"default_country_code\": \"FR\"\n}"
            },
            "description": "Normalizes/validates a phone number against a per-country expected-length table, flagging assumed_country_prefix when the country was inferred rather than explicit."
          }
        },
        {
          "name": "IP Anonymizer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/ip_anonymizer", "host": ["{{base_url}}"], "path": ["v1", "ip_anonymizer"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"raw_ip_address\": \"2001:db8:85a3::8a2e:370:7334\"\n}"
            },
            "description": "GDPR-style IP truncation. IPv4: zeroes the last octet. IPv6: expands compressed '::' notation to 8 full hextet groups, then zeroes the last 5 of 8 groups."
          }
        },
        {
          "name": "Log Sanitizer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/log_sanitizer", "host": ["{{base_url}}"], "path": ["v1", "log_sanitizer"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"log_data\": \"user=4111111111111111 auth=Bearer eyJhbGciOiJIUzI1NiJ9... key=sk_live_51H8x from 203.0.113.42\"\n}"
            },
            "description": "Strips 5 categories of sensitive data from raw log lines: Luhn-validated cards, emails, Bearer tokens, cloud API keys (sk_live_/sk_test_/pk_live_/AKIA), JWTs, and IPv4 addresses."
          }
        }
      ]
    },
    {
      "name": "Security & Link Integrity",
      "item": [
        {
          "name": "Crypto Verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/crypto_verify", "host": ["{{base_url}}"], "path": ["v1", "crypto_verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa\",\n  \"network\": \"bitcoin\"\n}"
            },
            "description": "Validates a crypto wallet address format/checksum for a given network before you send funds to it."
          }
        },
        {
          "name": "Bot Detector",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/bot_detector", "host": ["{{base_url}}"], "path": ["v1", "bot_detector"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headers_payload\": { \"user-agent\": \"Mozilla/5.0 ...\", \"accept-language\": \"en-US,en;q=0.9\" },\n  \"fingerprint_meta\": { \"webdriver\": false, \"plugins_length\": 3 }\n}"
            },
            "description": "Scores incoming traffic as human/bot/suspicious from request headers + client-side fingerprint metadata."
          }
        },
        {
          "name": "Link Signer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/link_signer", "host": ["{{base_url}}"], "path": ["v1", "link_signer"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_url\": \"https://example.com/download/report.pdf\",\n  \"expiration_minutes\": 30,\n  \"secret_salt\": \"a-secret-you-control-min-8-chars\"\n}"
            },
            "description": "Generates a tamper-proof, time-limited signed URL. secret_salt is mandatory (min 8 chars, no silent server-side default) so only you can validate your own links."
          }
        },
        {
          "name": "Link Validator",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/link_validator", "host": ["{{base_url}}"], "path": ["v1", "link_validator"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signed_url\": \"https://example.com/download/report.pdf?exp=...&sig=...\",\n  \"secret_salt\": \"a-secret-you-control-min-8-chars\"\n}"
            },
            "description": "Verifies a link signed by Link Signer, distinguishing LINK_EXPIRED from SIGNATURE_MISMATCH_ATTACK_DETECTED."
          }
        }
      ]
    },
    {
      "name": "Data & Media Utilities",
      "item": [
        {
          "name": "CSV Dedupe",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/csv_dedupe", "host": ["{{base_url}}"], "path": ["v1", "csv_dedupe"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"csvRaw\": \"email,name\\njohn@x.com,John\\njohn@x.com,John Duplicate\",\n  \"hasHeader\": true,\n  \"dedupeColumns\": [\"email\"]\n}"
            },
            "description": "RFC 4180-compliant CSV parsing with dedupe on one or more chosen columns."
          }
        },
        {
          "name": "Exif Cloak",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/exif_cloak", "host": ["{{base_url}}"], "path": ["v1", "exif_cloak"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"<base64-encoded JPEG/PNG bytes>\"\n}"
            },
            "description": "Strips EXIF/GPS metadata from an image. Detects the real file type via binary signature, not extension/MIME."
          }
        },
        {
          "name": "Timezone Converter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/timezone_converter", "host": ["{{base_url}}"], "path": ["v1", "timezone_converter"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_date_string\": \"2026-09-24T09:30:00\",\n  \"source_tz\": \"Europe/Paris\",\n  \"target_tz\": \"America/New_York\"\n}"
            },
            "description": "Converts a date/time between IANA timezones with DST-aware, per-instant offset resolution; detects naive vs explicit-offset input."
          }
        },
        {
          "name": "Uptime Check",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/uptime_check", "host": ["{{base_url}}"], "path": ["v1", "uptime_check"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_url\": \"https://example.com\",\n  \"timeout_ms\": 5000\n}"
            },
            "description": "Classifies a target as ONLINE/DEGRADED/OFFLINE. timeout_ms is clamped server-side between 500ms and 15s."
          }
        }
      ]
    }
  ]
}
